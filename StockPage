/** الجرد والتحويلات بين الفروع — بيانات حقيقية عبر tRPC */
import { useMemo, useState } from "react";
import { DataTable, DocShell, ErpInput, ErpSelect, FieldCell, Ribbon, RibbonBtn, RibbonGroup } from "@/components/erp/ui";
import { trpc } from "@/lib/trpc";

const STATUS_LABEL: Record<string, string> = { draft: "مسودة", final: "معتمد", posted: "مرحّلة", cancelled: "ملغاة" };
const TRANSFER_STATUS_LABEL: Record<string, string> = { draft: "مسودة", in_transit: "في الطريق", received: "مستلم", cancelled: "ملغاة" };

export function StockCountsPage({ transfers = false }: { transfers?: boolean }) {
  const [selected, setSelected] = useState<number | null>(null);
  const counts = trpc.erp.inventory.stockCounts.list.useQuery({});
  const transfersData = trpc.erp.inventory.transfers.list.useQuery({});

  if (!transfers) {
    return (
      <DocShell title="الجرد — عدّ المخزون الفعلي وتسوية الفروقات" docNo="SC-2026-0013">
        <Ribbon>
          <RibbonGroup label="الجرد">
            <RibbonBtn icon="📋" label="جرد جديد (F2)" primary />
            <RibbonBtn icon="➕" label="إدخال نتيجة عد" />
            <RibbonBtn icon="⚖" label="تسوية تلقائية (F9)" />
            <RibbonBtn icon="🖨" label="طباعة جرد" />
          </RibbonGroup>
        </Ribbon>

        <div className="doc-head four">
          <div className="block">
            <div className="block-title">بيانات الجرد</div>
            <div className="field-grid" style={{ gridTemplateColumns: "1fr 1fr" }}>
              <FieldCell label="رقم الجرد"><ErpInput defaultValue="SC-2026-0013" /></FieldCell>
              <FieldCell label="التاريخ"><ErpInput type="date" defaultValue="2026-08-12" /></FieldCell>
            </div>
          </div>
          <div className="block">
            <div className="block-title">الموقع</div>
            <div className="field-grid" style={{ gridTemplateColumns: "1fr 1fr" }}>
              <FieldCell label="الفرع"><ErpSelect options={[{ value: "1", label: "الفرع الرئيسي" }, { value: "2", label: "الفرع 2" }]} /></FieldCell>
              <FieldCell label="المخزن"><ErpSelect options={[{ value: "1", label: "مخزن الرئيسي" }]} /></FieldCell>
            </div>
          </div>
          <div className="block">
            <div className="block-title">نطاق الجرد</div>
            <div className="field-grid" style={{ gridTemplateColumns: "1fr 1fr" }}>
              <FieldCell label="المجموعة"><ErpSelect options={[{ value: "all", label: "كل الأصناف" }, { value: "cat", label: "مجموعة محددة" }]} /></FieldCell>
              <FieldCell label="العدّاد"><ErpInput placeholder="اسم العدّاد" /></FieldCell>
            </div>
          </div>
          <div className="block">
            <div className="block-title">التسوية</div>
            <div className="field-grid" style={{ gridTemplateColumns: "1fr" }}>
              <FieldCell label="حساب تسوية العجز"><ErpSelect options={[{ value: "6101", label: "6101 — مصروفات النقص" }]} /></FieldCell>
            </div>
          </div>
        </div>

        <DataTable
          data={(counts.data ?? []).map((c: any) => ({
            id: c.id, docNo: c.docNo, date: (c.docDate as Date).toISOString().slice(0, 10),
            branch: `فرع #${c.branchId}`, store: `مخزن #${c.storeId}`,
            kind: c.kind, status: c.status,
          }))}
          columns={[
            { key: "docNo", title: "رقم الجرد", width: 140 },
            { key: "date", title: "التاريخ", width: 100 },
            { key: "branch", title: "الفرع", width: 140 },
            { key: "store", title: "المخزن", width: 150 },
            { key: "kind", title: "نوع الجرد", width: 110, render: (r: any) => ({ periodic: "دوري", surprise: "مفاجئ", expiry: "صلاحية" }[r.kind as string] ?? r.kind) },
            { key: "status", title: "الحالة", width: 100, render: (r: any) => <span className={`status-badge ${r.status === "posted" ? "status-posted" : r.status === "final" ? "status-final" : "status-draft"}`}>{STATUS_LABEL[r.status] ?? r.status}</span> },
          ]}
          rowKey={(r: any) => r.id}
          selected={selected}
          onSelect={setSelected}
          height={380}
        />
      </DocShell>
    );
  }

  return (
    <DocShell title="التحويلات بين الفروع">
      <Ribbon>
        <RibbonGroup label="التحويل">
          <RibbonBtn icon="➕" label="تحويل جديد (F2)" primary />
          <RibbonBtn icon="🖨" label="طباعة" />
        </RibbonGroup>
      </Ribbon>
      <DataTable
        data={(transfersData.data ?? []).map((t: any) => ({ ...t, statusLabel: TRANSFER_STATUS_LABEL[t.status] ?? t.status }))}
        columns={[
          { key: "docNo", title: "رقم التحويل", width: 150 },
          { key: "date", title: "التاريخ", width: 100 },
          { key: "from", title: "من", width: 150 },
          { key: "to", title: "إلى", width: 150 },
          { key: "items", title: "الأصناف", width: 80, num: true },
          { key: "statusLabel", title: "الحالة", width: 110, render: (r: any) => <span className={`status-badge ${r.status === "received" ? "status-posted" : "status-draft"}`}>{r.statusLabel}</span> },
        ]}
        rowKey={(r: any) => r.id}
        selected={selected}
        onSelect={setSelected}
        height={440}
      />
    </DocShell>
  );
}
