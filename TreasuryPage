/** الصناديق والبنوك + التحويلات المالية — بيانات حقيقية عبر tRPC */
import { useMemo, useState } from "react";
import { DataTable, DocShell, ErpInput, ErpSelect, FieldCell, Ribbon, RibbonBtn, RibbonGroup } from "@/components/erp/ui";
import { trpc } from "@/lib/trpc";

export function TreasuryPage({ transfers = false }: { transfers?: boolean }) {
  const [selected, setSelected] = useState<number | null>(null);
  const accounts = trpc.erp.treasury.cashAccounts.list.useQuery({});
  const transfersData = trpc.erp.treasury.fundTransfers.list.useQuery({});

  if (transfers) {
    const rows = (transfersData.data ?? []).map((t: any) => ({
      id: t.id, docNo: t.docNo, date: (t.docDate as Date).toISOString().slice(0, 10),
      fromAccountId: t.fromAccountId, toAccountId: t.toAccountId,
      amount: (t.amount ?? t.total ?? 0) / 100, status: t.status,
      statusLabel: t.status === "posted" ? "مرحّلة" : t.status === "in_transit" ? "في الطريق" : "مسودة",
    }));
    return (
      <DocShell title="التحويلات المالية بين الصناديق والبنوك">
        <Ribbon>
          <RibbonGroup label="التحويل">
            <RibbonBtn icon="➕" label="تحويل جديد (F2)" primary />
            <RibbonBtn icon="🖨" label="طباعة" />
          </RibbonGroup>
        </Ribbon>
        <DataTable
          data={rows}
          columns={[
            { key: "docNo", title: "رقم التحويل", width: 150 },
            { key: "date", title: "التاريخ", width: 100 },
            { key: "fromAccountId", title: "من حساب #", width: 110, num: true },
            { key: "toAccountId", title: "إلى حساب #", width: 110, num: true },
            { key: "amount", title: "المبلغ", width: 120, num: true, render: (r: any) => r.amount.toFixed(2) },
            { key: "statusLabel", title: "الحالة", width: 100, render: (r: any) => <span className="status-badge status-posted">{r.statusLabel}</span> },
          ]}
          rowKey={(r: any) => r.id}
          selected={selected}
          onSelect={setSelected}
          height={440}
        />
      </DocShell>
    );
  }

  const rows = useMemo(() => {
    const data = (accounts.data ?? []).map((c: any) => ({
      id: c.id, name: c.name, code: c.code,
      kind: c.kind, kindLabel: c.kind === "bank" ? "بنك" : "صندوق",
      balance: (c.balance ?? 0) / 100,
      currency: c.currencyCode ?? c.currency ?? "YER",
    }));
    return { data, total: data.reduce((a: number, c: { balance: number }) => a + c.balance, 0) };
  }, [accounts.data]);

  return (
    <DocShell title="الصناديق والبنوك — أرصدة فورية">
      <Ribbon>
        <RibbonGroup label="الصندوق">
          <RibbonBtn icon="➕" label="صندوق/حساب جديد" />
          <RibbonBtn icon="💸" label="تحويل مالي (F2)" primary />
          <RibbonBtn icon="🖨" label="طباعة كشف" />
        </RibbonGroup>
        <RibbonGroup>
          <RibbonBtn icon="💵" label={`إجمالي السيولة: ${rows.total.toFixed(2)}`} />
        </RibbonGroup>
      </Ribbon>

      <div className="doc-head three">
        <div className="block">
          <div className="block-title">بيانات الحساب الجديد</div>
          <div className="field-grid" style={{ gridTemplateColumns: "1fr 1fr 1fr" }}>
            <FieldCell label="الاسم"><ErpInput placeholder="اسم الصندوق/الحساب" /></FieldCell>
            <FieldCell label="النوع"><ErpSelect options={[{ value: "box", label: "صندوق" }, { value: "bank", label: "بنك" }]} /></FieldCell>
            <FieldCell label="العملة"><ErpSelect options={[{ value: "YER", label: "ريال يمني" }]} /></FieldCell>
          </div>
        </div>
        <div className="block">
          <div className="block-title">القيود</div>
          <div className="field-grid" style={{ gridTemplateColumns: "1fr 1fr" }}>
            <FieldCell label="حد السحب"><ErpInput type="number" placeholder="0.00" /></FieldCell>
            <FieldCell label="المسؤول"><ErpInput placeholder="اسم المسؤول" /></FieldCell>
          </div>
        </div>
        <div className="block">
          <div className="block-title">إحصاء</div>
          <div style={{ fontSize: 12, padding: "2px 0" }}>
            عدد الصناديق: <b>{rows.data.filter((c: { kind: string }) => c.kind === "box").length}</b> — البنوك: <b>{rows.data.filter((c: { kind: string }) => c.kind === "bank").length}</b>
          </div>
        </div>
      </div>

      <DataTable
        data={rows.data}
        columns={[
          { key: "name", title: "الحساب", width: 260 },
          { key: "kindLabel", title: "النوع", width: 110 },
          { key: "balance", title: "الرصيد", width: 160, num: true, render: (r: any) => <span style={{ fontWeight: "bold" }}>{r.balance.toFixed(2)}</span> },
          { key: "currency", title: "العملة", width: 90 },
        ]}
        rowKey={(r: any) => r.id}
        selected={selected}
        onSelect={setSelected}
        height={300}
      />
    </DocShell>
  );
}
